<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色基础主题：parent 用 AppCompat（MainActivity 继承 AppCompatActivity）。
         具体配色由 Compose MaterialTheme 控制，这里只提供 window 背景与透明系统栏。 -->
    <style name="Theme.CourseSchedule" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
